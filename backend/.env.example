# Environment variables for the JMFeeds backend. Copy as backend/.env and adjust.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jmfeeds?schema=public"

# Port the Express API listens on
PORT=3000

# Secret for signing JWT session tokens â€” use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
